# Copy to .env. These are LOCAL/MOCK placeholders only.
# In real AWS environments these values come from Secrets Manager / IAM roles,
# never from a checked-in .env file. See ADR-009 and docs/hld/05_cicd_security_hld.md.

ENVIRONMENT=dev

# Local adapter for S3 (used when AWS_USE_LOCAL_ADAPTERS=true)
AWS_USE_LOCAL_ADAPTERS=true
LOCAL_S3_ROOT=.local_s3

# Local adapter for the control/audit database (SQLite) — represents an RDS/DynamoDB
# control schema in a real deployment (see docs/lld/01_sqlserver_incremental_ingestion_lld.md)
CONTROL_DB_PATH=.local_s3/control.sqlite3

# Placeholder source credentials — NEVER real values. In AWS these are Secrets Manager
# secret ARNs resolved at runtime by the Glue/EMR execution role, e.g.:
#   SQLSERVER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:retail/sqlserver-XXXXXX
SQLSERVER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:retail/dev/sqlserver-mock
SAP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:retail/dev/sap-mock
REST_API_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:retail/dev/api-mock

# Mock local values used only when AWS_USE_LOCAL_ADAPTERS=true
SQLSERVER_MOCK_USER=demo_user
SQLSERVER_MOCK_PASSWORD=replace_me_local_only
REST_API_MOCK_KEY=replace_me_local_only

# SNS topic ARN (mocked as a local log sink when AWS_USE_LOCAL_ADAPTERS=true)
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:retail-dev-pipeline-alerts

# KMS key alias (mocked as a no-op in local mode)
KMS_KEY_ALIAS=alias/retail-dev-data-key
